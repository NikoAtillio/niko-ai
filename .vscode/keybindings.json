[
  {
    "key": "cmd+alt+c",
    "command": "mql_tools.compileFile",
    "when": "editorTextFocus && (resourceExtname == .mq4 || resourceExtname == .mq5 || resourceExtname == .mqh)"
  },
  {
    "key": "cmd+alt+k",
    "command": "mql_tools.checkFile",
    "when": "editorTextFocus && (resourceExtname == .mq4 || resourceExtname == .mq5 || resourceExtname == .mqh)"
  },
  {
    "key": "cmd+alt+o",
    "command": "mql_tools.openMetaEditor",
    "when": "editorTextFocus && (resourceExtname == .mq4 || resourceExtname == .mq5 || resourceExtname == .mqh)"
  },
  {
    "key": "cmd+alt+f",
    "command": "mql_tools.formatCode",
    "when": "editorTextFocus && (resourceExtname == .mq4 || resourceExtname == .mq5 || resourceExtname == .mqh)"
  }
]
