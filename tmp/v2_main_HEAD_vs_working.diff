+def add_daily_sma21(daily: pd.DataFrame) -> pd.DataFrame:
+    """Add 21-day SMA for LTF directional bias layer."""
+    daily = daily.copy()
+    daily['sma21d'] = daily['close'].rolling(21).mean()
+    daily['ltf_bias'] = np.where(daily['close'] >= daily['sma21d'], 'bull', 'bear')
     return daily
+
+def add_weekly_bias(weekly: pd.DataFrame) -> pd.DataFrame:
+    """Add 20-week SMA for HTF directional bias layer."""
+    weekly = weekly.copy()
+    weekly['sma20w'] = weekly['close'].rolling(20).mean()
+    weekly['htf_bias'] = np.where(weekly['close'] >= weekly['sma20w'], 'bull', 'bear')
+    return weekly
+
+def get_htf_bias(weekly_idx: np.ndarray, weekly_htf_bias: np.ndarray, ts) -> str:
+    i = np.searchsorted(weekly_idx, ts, side='right') - 1
+    return weekly_htf_bias[i] if i >= 0 else 'bull'
+
+def get_ltf_bias(daily_idx: np.ndarray, daily_ltf_bias: np.ndarray, ts) -> str:
+    i = np.searchsorted(daily_idx, ts, side='right') - 1
+    return daily_ltf_bias[i] if i >= 0 else 'bull'
+
+def compute_bias_conf_adj(htf_bias: str, ltf_bias: str, direction: str) -> float:
+    """
+    Dual MA soft gate:
+      Both layers aligned WITH trade  -> 1.3x conf boost (easier to trigger)
+      Both layers AGAINST trade       -> 0.6x conf penalty (needs strong raw conf)
+      Conflicting layers              -> 1.0x neutral
+    """
+    htf_with = (htf_bias == 'bull' and direction == 'long') or \
+               (htf_bias == 'bear' and direction == 'short')
+    ltf_with = (ltf_bias == 'bull' and direction == 'long') or \
+               (ltf_bias == 'bear' and direction == 'short')
 
+    if htf_with and ltf_with:
+        return 1.3    # fully aligned - boost confidence
+    if not htf_with and not ltf_with:
+        return 0.6    # fully against - soft gate (needs conf_mult x 0.6 >= threshold)
+    return 1.0        # mixed - neutral, both directions remain open
+
